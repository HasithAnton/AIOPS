# ── Environments ──────────────────────────────────────
venv/
env/
.env

# ── Python ────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# ── OS ────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Archives ──────────────────────────────────────────
*.zip
*.tar.gz

# ── Heavy data files ──────────────────────────────────
data/
*.parquet

# ── Mininet CSVs (exclude all EXCEPT the augmented one used for demo) ─
emulation/mininet_telemetry.csv
emulation/mininet_telemetry_corrected.csv
emulation/mininet_telemetry_live.csv
emulation/mininet_telemetry_v2.csv
emulation/mininet_telemetry_v3.csv
# ↑ mininet_telemetry_augmented.csv is intentionally NOT excluded — needed for dashboard demo

# ── Trained model artefacts (exclude heavy ones, keep mininet demo models) ─
*.pt
*.h5
data/models/
# ↑ emulation/mininet_models/*.pkl and *.pth are intentionally NOT excluded — needed for demo

# ── Results / scratch ─────────────────────────────────
# results/ (tracked for benchmark documentation reports)
scratch/

# ── Logs ──────────────────────────────────────────────
*.log

# ── Word doc lock files ────────────────────────────────
.~lock.*
